        }
        .volume-slider {
            width: 100%;
            margin: 20px 0;
        }
    </style>
</head>
<body>
    <div class="card">
        <h1>🔊 تست صدای زنگ</h1>
        <p>برای اطمینان از کار کردن صدای تایمر، دکمه‌های زیر را امتحان کنید:</p>

        <div style="margin: 30px 0;">
            <button onclick="testSimpleTone()">🔔 تست صدای ساده</button>
            <button onclick="testChime()" class="success">🎵 تست زنگ دوگانه</button>
            <button onclick="testRepeating()" class="warning">🔁 تست تکرار (3 بار)</button>
        </div>

        <div class="info">
            <h3>📋 راهنما:</h3>
            <ul style="text-align: right;">
                <li>اگر هیچ صدایی نشنیدید، حجم گوشی خود را چک کنید</li>
                <li>در بعضی مرورگرها باید اول روی صفحه کلیک کنید</li>
                <li>اگر باز هم صدا نیامد، مرورگر شما Web Audio API را پشتیبانی نمی‌کند</li>
                <li>بهترین مرورگر: Chrome، Edge، Safari</li>
            </ul>
        </div>

        <div>
            <label for="volume">🔊 حجم صدا:</label>
            <input type="range" id="volume" class="volume-slider" min="0" max="100" value="70">
            <span id="volumeDisplay">70%</span>
        </div>

        <div id="status" style="margin-top: 20px; font-weight: bold;"></div>
    </div>

    <audio id="backupAudio" src="https://assets.mixkit.co/active_storage/sfx/2869/2869-preview.mp3" preload="auto"></audio>

    <script>
        let audioContext;
        let currentVolume = 0.7;

        // Initialize
        document.getElementById('volume').addEventListener('input', (e) => {
            currentVolume = e.target.value / 100;
            document.getElementById('volumeDisplay').innerText = e.target.value + '%';
        });

        // Test simple tone
        function testSimpleTone() {
            showStatus('در حال پخش صدای ساده...', '#0284c7');
            
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                const oscillator = audioContext.createOscillator();
                const gainNode = audioContext.createGain();
                
                oscillator.connect(gainNode);
                gainNode.connect(audioContext.destination);
                
                oscillator.frequency.value = 800;
                oscillator.type = 'sine';
                gainNode.gain.value = currentVolume;
                
                oscillator.start(audioContext.currentTime);
                oscillator.stop(audioContext.currentTime + 0.5);
                
                setTimeout(() => {
                    showStatus('✅ صدا پخش شد!', '#10b981');
                }, 600);
                
            } catch (err) {
                showStatus('❌ خطا: ' + err.message, '#ef4444');
            }
        }

        // Test chime (two tones)
        function testChime() {
            showStatus('در حال پخش زنگ دوگانه...', '#0284c7');
            
            try {
                const audioContext = new (window.AudioContext || window.webkitAudioContext)();
                
                // First tone
                playTone(audioContext, 800, 0, 0.3);
                
                // Second tone (higher pitch)
                setTimeout(() => {
                    playTone(audioContext, 1000, 0, 0.3);
                }, 200);
                
                setTimeout(() => {
                    showStatus('✅ زنگ دوگانه پخش شد!', '#10b981');
                }, 600);
                
            } catch (err) {
                showStatus('❌ خطا: ' + err.message, '#ef4444');
                // Fallback to HTML5 audio
                document.getElementById('backupAudio').play();
            }
        }

        // Test repeating sound
        function testRepeating() {
            showStatus('در حال پخش تکراری (3 بار)...', '#f59e0b');
            
            let count = 0;
            const interval = setInterval(() => {
                count++;
                testChime();
                
                if (count >= 3) {
                    clearInterval(interval);
                    setTimeout(() => {
                        showStatus('✅ تکرار کامل شد!', '#10b981');
                    }, 1000);
                }
            }, 1000);
        }

        // Helper: Play a tone
        function playTone(audioContext, frequency, delay, duration) {
            const oscillator = audioContext.createOscillator();
            const gainNode = audioContext.createGain();
            
            oscillator.connect(gainNode);
            gainNode.connect(audioContext.destination);
            
            oscillator.frequency.value = frequency;
            oscillator.type = 'sine';
            
            // Smooth fade in/out
            const now = audioContext.currentTime + delay;
            gainNode.gain.setValueAtTime(0, now);
            gainNode.gain.linearRampToValueAtTime(currentVolume, now + 0.01);
            gainNode.gain.linearRampToValueAtTime(0, now + duration);
            
            oscillator.start(now);
            oscillator.stop(now + duration);
        }

        // Show status message
        function showStatus(message, color) {
            const status = document.getElementById('status');
            status.innerText = message;
            status.style.color = color;
        }

        // Check browser support on load
        window.addEventListener('load', () => {
            if (!window.AudioContext && !window.webkitAudioContext) {
                showStatus('⚠️ مرورگر شما Web Audio API را پشتیبانی نمی‌کند. لطفاً از Chrome یا Edge استفاده کنید.', '#ef4444');
            } else {
                showStatus('✅ مرورگر شما آماده است. روی دکمه‌ها کلیک کنید.', '#10b981');
            }
        });
    </script>
</body>
</html>
